# Puttapaka Women's Handloom Textiles — Environment Variables
# Copy this file to .env.local and fill in real values before running or deploying.

# WhatsApp business number in international format — digits only, no spaces, no + or dashes
# Primary: +91 99125 70419 → 919912570419
NEXT_PUBLIC_WHATSAPP_NUMBER=919912570419

# Canonical site URL — no trailing slash
# Intended production domain; local development may use this canonical URL too.
NEXT_PUBLIC_SITE_URL=https://puttapakawomenshandloomtextiles.com

# Google Maps Embed API Key (optional — fallback displayed if omitted)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional, development-only comma-separated hostnames allowed to request
# Next.js dev assets from another device on the local network.
# Example: NEXT_DEV_ALLOWED_ORIGINS=192.168.1.42
NEXT_DEV_ALLOWED_ORIGINS=
